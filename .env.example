# Número comercial de WhatsApp en formato internacional, solo dígitos (código de país + número).
# Valor de ejemplo ficticio. El número real va únicamente en .env.local, que git ignora.
# Solo servidor: nunca con prefijo NEXT_PUBLIC_, o acabaría en el JavaScript público.
ERIZOPLAST_WHATSAPP_NUMBER=51900000000

# URL pública del sitio (sitemap, Open Graph). Opcional en local.
NEXT_PUBLIC_SITE_URL=

# --- Formulario de novedades (Fase 7) · pasos en CONFIGURACION-FASE-7.md ---
# Clave de API de Resend ("re_..."). Solo servidor. Sin ella el formulario responde «no disponible»
# y no recoge nada. Déjala vacía hasta tener una cuenta; nunca la pongas en este archivo.
ERIZOPLAST_RESEND_API_KEY=

# Correo que recibe un aviso por cada persona que deja sus datos. Opcional: si falta se usa el
# correo comercial de data/empresa.ts. Con el remitente de pruebas de Resend tiene que ser el
# mismo correo con el que se creó la cuenta de Resend.
ERIZOPLAST_CONTACTO_DESTINO=

# Remitente de los avisos. Opcional: si falta se usa "ERIZOPLAST <onboarding@resend.dev>" (solo
# pruebas). Con un dominio verificado en Resend: "ERIZOPLAST <avisos@tu-dominio.pe>".
ERIZOPLAST_CONTACTO_REMITENTE=
